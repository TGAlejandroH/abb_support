MODULE TG_Cell(SYSMODULE)
    !***********************************************************************
    ! Cell hardware macros for the TetraGen ABB prototype.
    !
    ! RAPID port of the small FANUC utility programs the .tgs programs call
    ! between requests - on FANUC each is a tiny standalone .ls program that
    ! flips a digital output:
    !   CAM_OPEN / CAM_CLOSE  ->  TG_CamOpen  / TG_CamClose   (working, dummy DO)
    !   WELD_PREP             ->  TG_WeldPrep                  (placeholder)
    !   CAM_PREP              ->  TG_CamPrep                   (placeholder)
    !   DRY_RUN_ON / _OFF     ->  TG_DryRunOn / TG_DryRunOff   (placeholder)
    ! The placeholders (added phase 4, 2026-08-28) are deliberately EMPTY
    ! PROCs - an empty routine body is legal RAPID (statement list may be
    ! empty; comments are not statements) - so .tgs programs can already
    ! call them in the FANUC call order while the cell hardware I/O is
    ! still unknown. TEACHMODE_ON belongs to the touch-sense family (out
    ! of v1 scope) and will follow the same pattern when that is ported.
    !
    ! Kept separate from TG_Comms.sys on purpose: TG_Comms is pure HMI
    ! protocol, this module is cell hardware. Loaded resident like TG_Comms;
    ! .tgs programs reach these PROCs through the task-wide global scope.
    !
    ! doTG_Camera is a DUMMY digital output driving the camera flap (the
    ! cover that shields the lens from weld spatter). It must exist in the
    ! I/O configuration (EIO) or the program check fails with an
    ! unknown-symbol error - creation steps in docs/robotstudio_setup.md. On
    ! the virtual controller leave it unassigned to any device (a simulated
    ! signal); TODO: on the real cell map it to the actual flap output.
    !***********************************************************************

    PROC TG_CamOpen()
        ! FANUC: CAM_OPEN (.ls utility) - open the camera flap.
        SetDO doTG_Camera,1;
        TPWrite "TG: camera flap open";
    ENDPROC

    PROC TG_CamClose()
        ! FANUC: CAM_CLOSE (.ls utility) - close the camera flap.
        ! The FANUC .tgs programs call this defensively in several places
        ! (after capture sets, after R_W_F, before rest home); calling it
        ! with the output already low is expected and harmless.
        SetDO doTG_Camera,0;
        TPWrite "TG: camera flap closed";
    ENDPROC

    PROC TG_WeldPrep()
        ! FANUC: WELD_PREP (.ls utility) - prepare the welding equipment.
        ! Called at program start and again after the capture sets, before
        ! the weld transitions (sample TD05tRJYQd.ls lines 19 and 63).
        ! PLACEHOLDER (phase 4): intentionally empty. TODO real cell:
        ! power-supply readiness / gas / weld-enable outputs - hardware-
        ! and welder-brand-specific.
    ENDPROC

    PROC TG_CamPrep()
        ! FANUC: CAM_PREP (.ls utility) - prepare the camera. Commented
        ! out even in the FANUC sample ("!-- CALL CAM_PREP", line 18).
        ! PLACEHOLDER (phase 4): intentionally empty. TODO real cell.
    ENDPROC

    PROC TG_DryRunOn()
        ! FANUC: DRY_RUN_ON (.ls utility) - disable welding so the program
        ! runs through all motions without striking an arc. The .tgs
        ! program calls TG_DryRunOff unconditionally after the password
        ! check, then TG_DryRunOn when the HMI sent dry_run=1 (R[199],
        ! sample lines 13-16).
        ! PLACEHOLDER (phase 4): intentionally empty. TODO real cell:
        ! weld-enable inhibit output / RobotWare Arc weld-enable state.
    ENDPROC

    PROC TG_DryRunOff()
        ! FANUC: DRY_RUN_OFF (.ls utility) - (re-)enable welding; the
        ! default state, set unconditionally after the password check.
        ! PLACEHOLDER (phase 4): intentionally empty. TODO real cell.
    ENDPROC

ENDMODULE
