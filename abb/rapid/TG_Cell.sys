MODULE TG_Cell(SYSMODULE)
    !***********************************************************************
    ! Cell hardware macros for the TetraGen ABB prototype.
    !
    ! RAPID port of the small FANUC utility programs the .tgs programs call
    ! between requests - on FANUC each is a tiny standalone .ls program that
    ! flips a digital output:
    !   CAM_OPEN / CAM_CLOSE  ->  TG_CamOpen  / TG_CamClose   (working, dummy DO)
    !   WELD_PREP             ->  TG_WeldPrep                  (placeholder)
    !   CAM_PREP              ->  TG_CamPrep                   (placeholder)
    !   DRY_RUN_ON / _OFF     ->  TG_DryRunOn / TG_DryRunOff   (placeholder)
    ! The placeholders (added phase 4, 2026-08-28) are deliberately EMPTY
    ! PROCs - an empty routine body is legal RAPID (statement list may be
    ! empty; comments are not statements) - so .tgs programs can already
    ! call them in the FANUC call order while the cell hardware I/O is
    ! still unknown.
    !
    ! Touch sensing (touch-sense P2, 2026-09-26): TEACHMODE_ON ->
    ! TG_TeachModeOn, plus TG_TouchSenseOn/Off, which TG_Touch.sys calls
    ! around every search. They drive the welder's touch-sense I/O BY NAME
    ! (the stTG_Touch* strings below), so a new welder or a test rig changes
    ! data, not code. docs/abb_touch_sense_port_v1.md D5/D11.
    !
    ! TG_ActMechUnit (added 2026-09-23) has no FANUC counterpart - a FANUC
    ! motion group is always active. Every HMI-mode .tgs module that drives
    ! a positioner calls it once before any motion; see the routine.
    !
    ! Kept separate from TG_Comms.sys on purpose: TG_Comms is pure HMI
    ! protocol, this module is cell hardware. Loaded resident like TG_Comms;
    ! .tgs programs reach these PROCs through the task-wide global scope.
    !
    ! doTG_Camera is a DUMMY digital output driving the camera flap (the
    ! cover that shields the lens from weld spatter). It must exist in the
    ! I/O configuration (EIO) or the program check fails with an
    ! unknown-symbol error - creation steps in docs/robotstudio_setup.md. On
    ! the virtual controller leave it unassigned to any device (a simulated
    ! signal); TODO: on the real cell map it to the actual flap output.
    !***********************************************************************

    ! ---- Touch sensing: the welder's touch-sense I/O, by name ------------
    ! "" = the cell has no such signal. CELL DATA, not code: these values are
    ! the MONARC VC's Miller EIP (the RobotWare Miller add-in's own names,
    ! the same ones SmarTac's smtMiller1 profile uses). The real MONARC cell
    ! is a Fronius TPS/i (smtFronius1: siFr1PartDetect / soFr1TouchSense /
    ! soFr1SensorRef) and gets its values at commissioning (plan P6).
    !
    ! stTG_TouchDI: the contact signal SearchL supervises (TG_TouchSearch).
    PERS string stTG_TouchDI:="diWld1Touched";
    ! stTG_TouchOnDO: puts the sense voltage on the wire (TG_TouchSenseOn).
    PERS string stTG_TouchOnDO:="doWld1TouchOn";
    ! stTG_TouchActiveDI: the welder confirms sensing is live; waited for up
    ! to nTG_TouchActiveWait s. MONARC's own programs always wait for it.
    PERS string stTG_TouchActiveDI:="diWld1TouchActive";
    PERS num nTG_TouchActiveWait:=2;
    ! stTG_TeachModeDO: Fronius TPS/i Teach mode (FANUC TEACHMODE_ON, D5);
    ! the Miller has none. On a TPS/i: "doFr1TeachMode" (RobotWare's
    ! FroniusTPSi equipment template).
    PERS string stTG_TeachModeDO:="";
    ! TRUE after TG_TouchSenseOn when the welder confirmed (or there is no
    ! active signal to wait for); TG_TouchSearch will not search otherwise.
    PERS bool bTG_TouchLive:=FALSE;

    ! AliasIO targets: must be module-level (TRM 1.6), bound before each use.
    LOCAL VAR signaldo doTG_TouchOnAlias;
    LOCAL VAR signaldi diTG_TouchActiveAlias;
    LOCAL VAR signaldo doTG_TeachModeAlias;

    PROC TG_CamOpen()
        ! FANUC: CAM_OPEN (.ls utility) - open the camera flap.
        SetDO doTG_Camera,1;
        TPWrite "TG: camera flap open";
    ENDPROC

    PROC TG_CamClose()
        ! FANUC: CAM_CLOSE (.ls utility) - close the camera flap.
        ! The FANUC .tgs programs call this defensively in several places
        ! (after capture sets, after R_W_F, before rest home); calling it
        ! with the output already low is expected and harmless.
        SetDO doTG_Camera,0;
        TPWrite "TG: camera flap closed";
    ENDPROC

    PROC TG_WeldPrep()
        ! FANUC: WELD_PREP (.ls utility) - prepare the welding equipment.
        ! Called at program start and again after the capture sets, before
        ! the weld transitions (sample TD05tRJYQd.ls lines 19 and 63).
        ! PLACEHOLDER (phase 4): intentionally empty. TODO real cell:
        ! power-supply readiness / gas / weld-enable outputs - hardware-
        ! and welder-brand-specific.
    ENDPROC

    PROC TG_CamPrep()
        ! FANUC: CAM_PREP (.ls utility) - prepare the camera. Commented
        ! out even in the FANUC sample ("!-- CALL CAM_PREP", line 18).
        ! PLACEHOLDER (phase 4): intentionally empty. TODO real cell.
    ENDPROC

    PROC TG_DryRunOn()
        ! FANUC: DRY_RUN_ON (.ls utility) - disable welding so the program
        ! runs through all motions without striking an arc. The .tgs
        ! program calls TG_DryRunOff unconditionally after the password
        ! check, then TG_DryRunOn when the HMI sent dry_run=1 (R[199],
        ! sample lines 13-16).
        ! PLACEHOLDER (phase 4): intentionally empty. TODO real cell:
        ! weld-enable inhibit output / RobotWare Arc weld-enable state.
    ENDPROC

    PROC TG_DryRunOff()
        ! FANUC: DRY_RUN_OFF (.ls utility) - (re-)enable welding; the
        ! default state, set unconditionally after the password check.
        ! PLACEHOLDER (phase 4): intentionally empty. TODO real cell.
    ENDPROC

    PROC TG_TeachModeOn()
        ! FANUC: TEACHMODE_ON (.ls utility) - the Fronius TPS/i Teach mode:
        ! the wire feeder retracts the wire when the nozzle nears the part, so
        ! the bridge moves between touches cannot bend it (Fronius signal
        ! description). Called once at the start of a touch block. Nothing
        ! turns it off: touch sensing ON disables it for each measurement
        ! (owner, D5) and welding turns it off by itself (owner, D11).
        ! No-op when the cell has no such output.
        VAR string stName;
        IF stTG_TeachModeDO="" RETURN;
        stName:=stTG_TeachModeDO;
        AliasIO stName,doTG_TeachModeAlias;
        SetDO doTG_TeachModeAlias,1;
    ERROR
        ! Hand an I/O error (a name the configuration does not know:
        ! ERR_ALIASIO_DEF) to the caller. Without a handler it would stop the
        ! task instead of reaching TG_TouchSearch's (VC-measured 40228, see
        ! tgOpenListener in TG_Comms.sys).
        RAISE;
    ENDPROC

    PROC TG_TouchSenseOn()
        ! The touch output FANUC's ArcTool drives itself during Search[] -
        ! no .ls of its own there. Called by TG_TouchSearch right before each
        ! search, so the sense voltage is live only while searching (D5).
        ! Sets bTG_TouchLive: TRUE when the welder confirmed within
        ! nTG_TouchActiveWait s, or when there is no confirmation to wait for.
        ! AliasIO needs a VAR/CONST string, hence the local copies.
        VAR string stName;
        VAR bool bTimeout:=FALSE;
        bTG_TouchLive:=FALSE;
        IF stTG_TouchOnDO<>"" THEN
            stName:=stTG_TouchOnDO;
            AliasIO stName,doTG_TouchOnAlias;
            SetDO doTG_TouchOnAlias,1;
        ENDIF
        IF stTG_TouchActiveDI<>"" THEN
            stName:=stTG_TouchActiveDI;
            AliasIO stName,diTG_TouchActiveAlias;
            WaitDI diTG_TouchActiveAlias,1\MaxTime:=nTG_TouchActiveWait\TimeFlag:=bTimeout;
        ENDIF
        bTG_TouchLive:=NOT bTimeout;
    ERROR
        ! Hand an I/O error (a name the configuration does not know:
        ! ERR_ALIASIO_DEF) to the caller. Without a handler it would stop the
        ! task instead of reaching TG_TouchSearch's (VC-measured 40228, see
        ! tgOpenListener in TG_Comms.sys).
        RAISE;
    ENDPROC

    PROC TG_TouchSenseOff()
        ! Right after each search - hit or miss (D5).
        VAR string stName;
        bTG_TouchLive:=FALSE;
        IF stTG_TouchOnDO="" RETURN;
        stName:=stTG_TouchOnDO;
        AliasIO stName,doTG_TouchOnAlias;
        SetDO doTG_TouchOnAlias,0;
    ERROR
        ! Hand an I/O error (a name the configuration does not know:
        ! ERR_ALIASIO_DEF) to the caller. Without a handler it would stop the
        ! task instead of reaching TG_TouchSearch's (VC-measured 40228, see
        ! tgOpenListener in TG_Comms.sys).
        RAISE;
    ENDPROC

    PROC TG_ActMechUnit()
        ! Activates the mechanical unit the .tgs program is about to drive.
        ! Every HMI-mode module that moves a positioner - indexed or
        ! coordinated - calls this once, before any motion. It also binds the
        ! station-free coordinated work object wobjTG_WeldActStn (TG_Comms.sys)
        ! to the same station (2026-09-23, VC-proven on both MONARC stations).
        !
        ! The call names no unit on purpose: which unit to activate is cell
        ! configuration, so a new cell changes THIS BODY, never the exporter
        ! or the generated programs. no_hmi modules do not call it - they
        ! must run with no TG modules resident, so they keep an inline ActUnit.
        !
        ! CELL-SPECIFIC BODY: MONARC two-station interchange - STN1/STN2 on
        ! one indexing table, INTERCH = the index, activated through the IRBP
        ! positioner package's ActStn<n>/DeactStn<n> (Irbp1Prc.sys). A cell
        ! without these units, signals and routines must replace this body, or
        ! TG_Cell will not load.
        !
        ! WHICH STATION IS AT THE ROBOT comes from the cell's in-position
        ! signals, EIO cross  siGap_AtStn_n := diLS_n_INPOS OR soLS_n_INPOS:
        ! the index limit switch on the real cell; on the VC, IndexToStn<n>
        ! sets soLS_n_INPOS after its fine move. NOT from CJointT(): INTERCH
        ! is deactivated again before the part routine runs, and a deactivated
        ! unit does not report its axes (reads 0 / 9E9, TG_RoboCal L12) - ABB's
        ! own IndexToStn<n> activates INTERCH before it reads CJointT. Index
        ! 0 deg = station 1 at the robot, 180 deg = station 2 (VC-measured).
        !
        ! UNDER PRODUCTION MANAGER, EE_PRE_PART (ActStn<n>) has already
        ! activated the presented station AND applied its MechUnitLoad, so
        ! the normal case changes nothing. Deactivating and re-activating it
        ! would drop that load (MechUnitLoad must follow ActUnit, per the TRM).
        ! A station activated HERE goes through the positioner package's own
        ! ActStn<n> - the routine PM's EE_PRE_PART hook (EvActStn<n>) calls, and
        ! the one MONARC's Utility.sys and part templates use - so it gets
        ! ActUnit AND MechUnitLoad with the part's partadv load (GetNextPartAdv),
        ! or the package's default load plus an "Activation Warning" when no
        ! part is queued (a run outside PM). DeactStn<n> is plain DeactUnit,
        ! used for symmetry. (2026-09-23: replaced a bare ActUnit, which
        ! activated the station with no payload.)
        !
        ! The stations share drives (contactors K1-K5), so the other station
        ! must be deactivated before this one is activated.
        VAR num nStn:=0;

        IF (siGap_AtStn_1=1) AND (siGap_AtStn_2=0) nStn:=1;
        IF (siGap_AtStn_2=1) AND (siGap_AtStn_1=0) nStn:=2;
        IF nStn=0 THEN
            ! Neither or both read in position: the table is mid-index or a
            ! switch is wrong. Never guess a station - end the program.
            ErrWrite "TG: no station at the robot","Neither station, or both, reads in position."\RL2:="Index a station to the robot, then restart.";
            EXIT;
        ENDIF
        IF nStn=1 THEN
            IF (NOT IsMechUnitActive(STN1)) THEN
                IF IsMechUnitActive(STN2) THEN
                    ErrWrite \W,"TG: wrong station was active","Station 1 is at the robot but station 2 was active."\RL2:="Switched to station 1.";
                    DeactStn2;
                ENDIF
                ActStn1;
                TPWrite "TG: station 1 activated";
            ENDIF
        ELSE
            IF (NOT IsMechUnitActive(STN2)) THEN
                IF IsMechUnitActive(STN1) THEN
                    ErrWrite \W,"TG: wrong station was active","Station 2 is at the robot but station 1 was active."\RL2:="Switched to station 2.";
                    DeactStn1;
                ENDIF
                ActStn2;
                TPWrite "TG: station 2 activated";
            ENDIF
        ENDIF
        ! The coordinated work object follows the same decision, on EVERY
        ! call - including the no-op path above, where PM activated the
        ! station - so activation and coordination never name different units.
        IF nStn=1 THEN
            wobjTG_WeldActStn.ufmec:="STN1";
        ELSE
            wobjTG_WeldActStn.ufmec:="STN2";
        ENDIF
    ENDPROC

ENDMODULE
