+def test_the_fanuc_touch_block_is_unchanged_by_the_native_marking():
+    """The provider's lines are now marked brand-native for every brand. FANUC's `runBrandCode`
+    is `runCode`, so the `.LS` must not change by one character."""
+    wrapper, programs = _touch_family(robot_brand=ROBOT_BRAND_FANUC, export_mode="")
+    marked = [instr for p in [wrapper] + programs for instr in p.instructions
+              if instr.instr_type == INSTR_CUSTOM_CODE]
+    assert marked and all(instr.brand_native_code for instr in marked)
+    body_marked = _compile(wrapper, programs, FanucTranslator())
+
+    unmarked_wrapper, unmarked_programs = copy.deepcopy(wrapper), copy.deepcopy(programs)
+    for program in [unmarked_wrapper] + unmarked_programs:
+        for instr in program.instructions:
+            instr.brand_native_code = False
+    body_unmarked = _compile(unmarked_wrapper, unmarked_programs, FanucTranslator())
+
+    assert body_marked == body_unmarked
+    assert "CALL R_TS_P" in body_marked and "Search[+X]" in body_marked
+
