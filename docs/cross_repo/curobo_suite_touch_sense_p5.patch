+    assert ", fine, " in moves[0]
+
+
+def test_the_touch_routines_are_resident():
+    """Bare `TG_ReqTouchSenseDo;` / `TG_ReqTouchSensePoint;` / `TG_TeachModeOn;` resolve at load
+    (`abb_support@03b1b8e`); a closed allow-list that lacked them would report REFUSE TO LOAD."""
+    translator = _hmi_translator()
+    for line in ("TG_ReqTouchSenseDo;", "TG_TeachModeOn;", "TG_ReqTouchSensePoint;",
+                 "TG_TouchSenseOn;", "TG_TouchSenseOff;"):
+        translator.runBrandCode(line)
+    translator.get_program_string()
+
+    assert not any("REFUSE TO LOAD" in w for w in translator.export_warnings)
+
+
+# ---------------------------------------------------------------------------
+# End to end: the real touch builders -> compiler -> translator
+# ---------------------------------------------------------------------------
+
+class _MainWindowStub:
+    def __init__(self, teach_mode=True):
+        self.config = {"WELDER_ENABLE_FRONIUS_TEACH_MODE": bool(teach_mode)}
+        self.scene_tree = None
+        self._joint_names_for_group = lambda group_name, fallback_all=False: list(ARM)
+        self._infer_robot_configuration = lambda joint_map: ("Front", "Up", "No Flip")
+
+
+def _seed(robot_brand, export_mode):
+    return types.SimpleNamespace(
+        frame_name="CAD",
+        frame_world=FRAME,
+        weld_program_name="PPP_Weld2",
+        robot_group_name="Robot 1",
+        robot_brand=robot_brand,
+        tcp_name="tcp_torch",
+        export_mode=export_mode,
+    )
+
+
+def _solved(index, touch):
+    approach = _approach_mm(touch)
+    return types.SimpleNamespace(
+        touch_index=index,
+        touch_program_id=f"touch_program_weld_2_{index}",
+        touch_program_name=f"TSWeld2_{index}",
+        search_axis_label=touch["label"],
+        solve_mode="strict",
+        approach_pose_world=_pose_world(approach),
+        contact_pose_world=_pose_world(touch["touch_mm"]),
+        approach_joint_map=_joints(0.01 * index),
+        contact_joint_map=_joints(0.01 * index + 0.001),
+    )
+
+
+def _bridge(program_id, name, robot_brand, offset):
+    embedded = EmbeddedTargetPose(
+        parent_frame_name="CAD",
+        cartesian_matrix_local_flat=list(np.eye(4).reshape(-1)),
+        joint_values=_joints(offset),
+        external_joint_values={},
+        has_external_snapshot=False,
+    )
+    return RobotProgram(
+        program_id=program_id,
+        name=name,
+        parent_frame_name="CAD",
+        robot_group_name="Robot 1",
+        robot_brand=robot_brand,
+        instructions=[
+            ProgramInstruction(program_id=program_id, instruction_id=f"{program_id}_f",
+                               instr_type=INSTR_SET_FRAME, frame_name="CAD"),
+            ProgramInstruction(program_id=program_id, instruction_id=f"{program_id}_j",
+                               instr_type=INSTR_MOVE_J, embedded_target=embedded),
+        ],
+    )
+
+
+def _touch_family(robot_brand=ROBOT_BRAND_ABB, export_mode=ABB_EXPORT_MODE_HMI, teach_mode=True):
+    """The wrapper plus every program it CALLs, from the REAL builders (no IK, no Qt)."""
+    service = WeldTouchGenerationService(_MainWindowStub(teach_mode=teach_mode))
+    weld = WeldItem(weld_id="weld_2", name="Weld2")
+    seed = _seed(robot_brand, export_mode)
+    solved = [_solved(i, touch) for i, touch in enumerate(TOUCHES)]
+    touches = [service._build_touch_program(weld=weld, seed=seed, solved_touch=s) for s in solved]
+    bridges = [
+        _bridge("bridge_first", service._touch_bridge_name_first(weld), robot_brand, 0.2),
+        _bridge("bridge_mid", service._touch_bridge_name_between(solved[0].touch_program_name,
+                                                                 solved[1].touch_program_name), robot_brand, 0.3),
+        _bridge("bridge_last", service._touch_bridge_name_last(weld, solved[1].touch_program_name), robot_brand, 0.4),
+    ]
+    wrapper = service._build_wrapper_program(weld=weld, seed=seed, solved_touch_points=solved,
+                                             bridge_programs=bridges)
+    return wrapper, touches + bridges
+
+
+class _Scene:
+    robot_tools = []
+
+    def __init__(self, programs):
+        self._programs = {str(p.program_id): p for p in programs}
+        self.robot_groups = [RobotGroup(name="Robot 1", joint_names=ARM, arm_joint_names=ARM, robot_brand="abb")]
+
+    def get_robot_program(self, program_id):
+        return self._programs.get(str(program_id))
+
+    def get_cell_program(self, program_id):
+        return None
+
+    def get_robot_group(self, name):
+        return self.robot_groups[0] if str(name) == "Robot 1" else None
+
+    def get_robot_tool(self, name):
+        if str(name) != "tcp_torch":
+            return None
+        tool = np.eye(4)
+        tool[2, 3] = 0.4
+        return types.SimpleNamespace(name="tcp_torch", robot_group_name="Robot 1", tool_matrix=lambda: tool)
+
+    def get_robot_target(self, name):
+        return None
+
+    def get_external_axis_group(self, name):
+        return None
+
+    def get_all_external_axis_groups(self):
+        return []
+
+    def get_frame_by_name(self, name):
+        return object() if str(name) == "CAD" else None
+
+
+def _compile(wrapper, programs, translator, export_config=None):
+    compiler = ProgramCompiler(
+        scene_tree=_Scene([wrapper] + list(programs)),
+        get_target_cartesian_world_matrix_fn=lambda _name: None,
+        get_frame_world_matrix_fn=lambda name: FRAME if str(name) == "CAD" else None,
+        resolve_program_export_config_fn=lambda _program: (dict(export_config) if export_config else None),
+        get_joint_unit_fn=lambda _name: "rad",
+    )
+    success, message = compiler.compile(wrapper.program_id, translator, None, inline_called_programs=True)
+    assert success, message
+    return translator.get_program_string()
+
+
+def _hmi_config(program):
+    return build_abb_program_export_config(program, resolve_abb_output_profile(ABB_OUTPUT_PROFILE_ID_HMI))
+
+
+def test_a_generated_touch_block_compiles_to_the_td05touch_shape():
+    """The whole P5 chain -- provider -> real touch builders -> compiler -> HMI profile ->
+    translator -> RAPID -- against `TD05Touch.mod`'s touch block: frame request, abort check,
+    do-touch flag, camera close, the `IF`, Teach mode, then per touch approach -> search ->
+    report -> 0.5 s -> return, and the end request that writes the corrected frame."""
+    wrapper, programs = _touch_family()
+    translator = AbbTranslator("R")
+    body = _compile(wrapper, programs, translator, _hmi_config(wrapper))
+    statements = _statements(body)
+
+    per_touch = [
+        r"MoveJ pTG\d{4}, .*\\WObj:=wobjTG_Weld;",                           # Cartesian approach
+        r"MoveL pTG\d{4}, vTG\d{3}, fine, tTG_Weld \\WObj:=wobjTG_Weld;",   # the anchor
+        r"TG_TouchSearch pTG\d{4}, pTG\d{4}, tTG_Weld, wobjTG_Weld;",
+        r"TG_ReqTouchSensePoint;",
+        r"WaitTime 0\.5\d*;",
+        r"MoveL pTG\d{4}, vTG\d{3}, fine, tTG_Weld \\WObj:=wobjTG_Weld;",   # the return
+    ]
+    _assert_in_order(statements, [
+        r'stTG_SubName:="TSPWeld2_full";',
+        r"TG_ReqWeldFrame \\Tool:=tTG_Weld \\WObj:=wobjTG_Weld;",
+        r"IF nTG_WeldStatus=2 GOTO abort_end;",
+        r"TG_ReqTouchSenseDo;",
+        r"TG_CamClose;",
+        r"IF nTG_DoTouchSense=1 THEN",
+        r"TG_TeachModeOn;",
+        r"MoveAbsJ jtTG\d{4}, .*",                                   # the entry bridge
+        *per_touch,
+        r"MoveAbsJ jtTG\d{4}, .*",                                   # the bridge between touches
+        *per_touch,
+        r"MoveAbsJ jtTG\d{4}, .*",                                   # the exit bridge
+        r"TG_ReqTouchSenseEnd \\WObj:=wobjTG_Weld;",
+        r"ENDIF",
+    ])
+    # One search and one report per touch, in the planner's touch order -- the HMI fills touch
+    # point N with the Nth report.
+    assert sum(s.startswith("TG_TouchSearch ") for s in statements) == 2
+    assert statements.count("TG_ReqTouchSensePoint;") == 2
+    assert "! [not RAPID, not emitted]" not in body
+    # The one expected warning is the component's: `abort_end` belongs to the package main.
+    unexpected = [w for w in translator.export_warnings
+                  if ("REFUSE TO LOAD" in w and "abort_end" not in w)
+                  or "will NOT search" in w or "off the work object" in w]
+    assert unexpected == []
+
+
+def test_each_search_runs_from_its_approach_to_its_contact_in_cad():
+    """The numbers behind the shape: search N goes from touch N's approach (touch + 30 mm along
+    the snapped axis) to touch N itself, in the CAD frame the HMI stores the touch points in."""
+    wrapper, programs = _touch_family()
+    body = _compile(wrapper, programs, AbbTranslator("R"), _hmi_config(wrapper))
+    targets = _robtargets(body)
+    searches = re.findall(r"TG_TouchSearch (pTG\d{4}), (pTG\d{4}),", body)
+
+    assert len(searches) == 2
+    for (start, end), touch in zip(searches, TOUCHES):
+        np.testing.assert_allclose(targets[start], _approach_mm(touch), atol=1e-3)
+        np.testing.assert_allclose(targets[end], touch["touch_mm"], atol=1e-3)
+
+
+def test_no_teach_mode_line_when_the_switch_is_off():
+    wrapper, programs = _touch_family(teach_mode=False)
+    body = _compile(wrapper, programs, AbbTranslator("R"), _hmi_config(wrapper))
+
+    assert "TG_TeachModeOn" not in body
+    assert "TG_ReqTouchSenseDo;" in body
