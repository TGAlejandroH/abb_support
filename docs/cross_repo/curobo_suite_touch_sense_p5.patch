+    wrapper, programs = _touch_family(robot_brand=ROBOT_BRAND_FANUC, export_mode="")
+    search = next(i for p in programs for i in p.instructions if i.instr_type == INSTR_MOVE_L_SEARCH)
+    assert search.search_contact_embedded_target is not None
