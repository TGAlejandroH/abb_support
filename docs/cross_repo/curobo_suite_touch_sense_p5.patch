+"""Touch-sense **P5** -- ABB offset touch sensing (auto touch-ups) from the Weld Planner.
+
+The FANUC offset touch-sense family (HMI requests 16 R_TS_D, 17 R_TS_F, 18 R_TS_P, 19 R_TS_END)
+was ported to RAPID in `abb_support` (docs/abb_touch_sense_port_v1.md, P0-P3 VC-proven): the
+resident routines `TG_ReqTouchSenseDo` / `TG_ReqTouchSensePoint` / `TG_ReqTouchSenseEnd`
+(`TG_Comms.sys`), the search primitive `TG_TouchSearch` (`TG_Touch.sys`) and `TG_TeachModeOn`
+(`TG_Cell.sys`). Its reference module `abb_support:abb/rapid/TGS/TD05Touch.mod` is the executable
+spec of what this exporter must emit for a touch-sensed weld.
+
+Three pieces, one per layer, all pinned here:
+
+- **the blocks provider** frames the touches: the TSP frame request, the do-touch flag, Teach
+  mode, the touch-hit report and the end request -- FANUC's order, RAPID's routines, no id 17;
+- **the compiler** hands the translator the solved contact the planner already stores on every
+  search instruction (`search_contact_embedded_target`), which FANUC's `Search[+X]` never needed;
+- **the translator** emits one `TG_TouchSearch <approach>, <contact>, tTG_Weld, wobjTG_Weld;`
+  where FANUC emits `L P[n] FINE Search[+X]`, and refuses (plain `MoveL`, loud warning) where
+  there is no honest search to emit.
+
+And one precondition in generation: ABB touches only in HMI mode, and only on indexed welds.
+"""
+
+import os
+
+# Must precede `import numpy` -- see tests/test_abb_translator.py.
+os.environ.setdefault("KMP_DUPLICATE_LIB_OK", "TRUE")
+os.environ.setdefault("QT_QPA_PLATFORM", "offscreen")
+
+import copy
+import math
+import re
+import types
+
+import numpy as np
+import pytest
+
+from tguide_lib.ProgramCompiler import ProgramCompiler
+from tguide_lib.ProgramInstruction import (
+    INSTR_CUSTOM_CODE,
+    INSTR_MOVE_J,
+    INSTR_MOVE_L_SEARCH,
+    INSTR_SET_FRAME,
+    EmbeddedTargetPose,
+    ProgramInstruction,
+)
+from tguide_lib.RobotGroup import RobotGroup
+from tguide_lib.RobotProgram import RobotProgram
+from tguide_lib.Translators.AbbTranslator import AbbTranslator
+from tguide_lib.Translators.FanucTranslator import FanucTranslator
+from tguide_lib.WeldWorkflowProject import WeldItem
+from tguide_lib.robot_brand_program_blocks.abb_program_blocks import ABB_ABORT_LABEL, AbbProgramBlocksProvider
+from tguide_lib.robot_brand_program_blocks.base_program_blocks import TouchsenseProgramBlocksContext
+from tguide_lib.robot_branding import ROBOT_BRAND_ABB, ROBOT_BRAND_FANUC
+from tguide_lib.workflows.abb_output_profiles import (
+    ABB_EXPORT_MODE_HMI,
+    ABB_EXPORT_MODE_NO_HMI,
+    ABB_OUTPUT_PROFILE_ID_HMI,
+    build_abb_program_export_config,
+    resolve_abb_output_profile,
