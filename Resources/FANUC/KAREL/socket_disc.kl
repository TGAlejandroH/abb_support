PROGRAM SOCKET_DISC
    -- Socket Disconnection

VAR
    comm_file:          FILE
    status:             INTEGER
    entry:              INTEGER
    cmd:                STRING[254]
    resp:               STRING[254]    

BEGIN -- Begin Program
    
    -- WRITE(CHR(128), CHR(137))
    MSG_DISCO('S3:',status)
    WRITE('SOCKET DISCONNECTED', CR)

END SOCKET_DISC
