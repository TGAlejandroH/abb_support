PROGRAM R_C
    -- Request Capture

VAR
    comm_file:          FILE
    status:             INTEGER
    cmd:                STRING[254]
    resp:               STRING[254]
    sub_name:           STRING[254]
    out:                STRING[254]
    cpos:               XYZWPR
    capture_status:     INTEGER


BEGIN
    
    -- Delay to wait for vibrations to dampen. Adjust as needed.
    DELAY 5
    
    WRITE('Requesting capture frame.', CR)
    SET_FILE_ATR(comm_file, ATR_IA)
    OPEN FILE comm_file ('rw', 'S3:')

    -- Sending request ID
    resp = '2' -- request id
    WRITE comm_file (resp)
    READ comm_file (cmd::1)

    -- Sending current pose
    $GROUP[1].$UTOOL = $MNUTOOL[1,$MNUTOOLNUM[1]]
    $GROUP[1].$UFRAME = $MNUFRAME[1,$MNUFRAMENUM[1]]
    
    cpos = CURPOS(0, 0)
    CNV_REAL_STR(cpos.x, 8, 3, out)
    resp =  out

    CNV_REAL_STR(cpos.y, 8, 3, out)
    resp = resp + ',' + out

    CNV_REAL_STR(cpos.z, 8, 3, out)
    resp = resp + ',' + out

    CNV_REAL_STR(cpos.w, 8, 3, out)
    resp = resp + ',' + out

    CNV_REAL_STR(cpos.p, 8, 3, out)
    resp = resp + ',' + out

    CNV_REAL_STR(cpos.r, 8, 3, out)
    resp = resp + ',' + out

    WRITE('Sending capture frame:',CR,resp, CR)

    WRITE comm_file (resp)
    READ comm_file (cmd::1)
    
    -- Sending sub_name
    GET_STR_REG(25,sub_name,status)
    WRITE('sub_name.',sub_name, CR)
    WRITE comm_file (sub_name)
    READ comm_file (cmd::1)
	
    -- Receiving camera capture status
    WRITE comm_file ('Give me capture status')
    READ comm_file (cmd::1)
    CNV_STR_INT(cmd,capture_status)
    SET_INT_REG(196,capture_status,status)

    CLOSE FILE comm_file
END R_C